
# ==========================================
# Adaptive QoS Engine - Network Topology
# ==========================================

# Project namespace names
DEVICE_NAMESPACES="qos-call qos-game qos-tv1 qos-tv2 qos-tv3 qos-bulk qos-laptop"
INFRA_NAMESPACES="qos-router qos-modem qos-isp"

# LAN network
LAN_IPV4="10.10.0.0/24"
LAN_IPV6="fd10:10::/64"

# Device IPv4 addresses
CALL_IPV4="10.10.0.11"
GAME_IPV4="10.10.0.12"
TV1_IPV4="10.10.0.13"
TV2_IPV4="10.10.0.14"
TV3_IPV4="10.10.0.15"
BULK_IPV4="10.10.0.16"
LAPTOP_IPV4="10.10.0.17"

# Device IPv6 addresses
CALL_IPV6="fd10:10::11"
GAME_IPV6="fd10:10::12"
TV1_IPV6="fd10:10::13"
TV2_IPV6="fd10:10::14"
TV3_IPV6="fd10:10::15"
BULK_IPV6="fd10:10::16"
LAPTOP_IPV6="fd10:10::17"

# Ordered device address lists (must match DEVICE_NAMESPACES)
DEVICE_IPV4_ADDRESSES="$CALL_IPV4 $GAME_IPV4 $TV1_IPV4 $TV2_IPV4 $TV3_IPV4 $BULK_IPV4 $LAPTOP_IPV4"
DEVICE_IPV6_ADDRESSES="$CALL_IPV6 $GAME_IPV6 $TV1_IPV6 $TV2_IPV6 $TV3_IPV6 $BULK_IPV6 $LAPTOP_IPV6"

# Router
ROUTER_BRIDGE="br-lan"
ROUTER_LAN_IPV4="10.10.0.1/24"
ROUTER_LAN_IPV6="fd10:10::1/64"

ROUTER_WAN="r-wan"
ROUTER_WAN_IPV4="10.20.0.1/30"
ROUTER_WAN_IPV6="fd10:20::1/126"

# Modem
MODEM_LAN="m-lan"
MODEM_LAN_IPV4="10.20.0.2/30"
MODEM_LAN_IPV6="fd10:20::2/126"

MODEM_WAN="m-wan"
MODEM_WAN_IPV4="10.30.0.1/30"
MODEM_WAN_IPV6="fd10:30::1/126"

# Modem qdisc hierarchy
# Root: TBF (rate limiting and queue limit)
# Child: netem (delay, jitter and packet loss)
MODEM_QDISC_ROOT_KIND="tbf"
MODEM_QDISC_ROOT_HANDLE="1:"
MODEM_QDISC_CHILD_KIND="netem"
MODEM_QDISC_CHILD_HANDLE="10:"
MODEM_QDISC_CHILD_PARENT="1:1"

# ISP
ISP_INTERFACE="isp0"
ISP_IPV4="10.30.0.2/30"
ISP_IPV6="fd10:30::2/126"

# Traffic bottleneck defaults
MODEM_RATE="100mbit"
MODEM_BURST="128k"
MODEM_LIMIT="3mb"

# Network impairment defaults
MODEM_DELAY="10ms"
MODEM_JITTER="2ms"
MODEM_LOSS="0%"

# Traffic server ports
IPERF3_PORT="5201"
CALL_PORT="6001"
GAME_PORT="6002"
HTTP_PORT="8080"

# Device interface convention
DEVICE_INTERFACE="eth0"

# NAT disabled for initial experiments
ENABLE_NAT="false"

# ==========================================
# Virtual interface mappings
# ==========================================

CALL_ROUTER_IF="r-call"
GAME_ROUTER_IF="r-game"
TV1_ROUTER_IF="r-tv1"
TV2_ROUTER_IF="r-tv2"
TV3_ROUTER_IF="r-tv3"
BULK_ROUTER_IF="r-bulk"
LAPTOP_ROUTER_IF="r-laptop"

ROUTER_MODEM_IF="r-wan"
MODEM_ROUTER_IF="m-lan"

MODEM_ISP_IF="m-wan"
ISP_MODEM_IF="isp0"

# IPv4 and IPv6 forwarding
ENABLE_IPV4_FORWARDING="1"
ENABLE_IPV6_FORWARDING="1"

# Disable router advertisements in infrastructure namespaces
DISABLE_ACCEPT_RA="0"

# Device link MTU
TESTBED_MTU="1500"
